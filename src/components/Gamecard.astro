---
interface Props {
  slug: string;
  title: string;
  intro: string;
  image: string;
  imageSrcset?: string;
  genre: string;
}

const { slug, title, intro, image, imageSrcset, genre } = Astro.props;
---

<article class="review-card">
    <a class="card-link" href={`/${slug}/`}>
      <div class="card-art card-art-image">
        <img src={image} srcset={imageSrcset} sizes={imageSrcset ? '(max-width: 760px) calc(100vw - 42px), (max-width: 1200px) calc((100vw - 124px) / 3 - 2px), 357px' : undefined} alt={title} decoding="async" />
      </div>
      <div class="card-content">
        <p class="eyebrow">{genre}</p>
        <h2 class="card-title">{title}</h2>
        <p>{intro}</p>
      </div>
    </a>
</article>
